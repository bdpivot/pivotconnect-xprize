[2026-08-01T15:55:06.416Z] import pandas as pd

def run_projection(
    start_revenue,
    fixed_costs,
    price_per_unit,
    variable_cost_per_unit,
    growth_rate,
    months,
    scenario_name
):
    """
    Projects monthly financials to find the break-even point.
    """
    data = []
    cumulative_cash_flow = 0
    max_cash_needed = 0
    break_even_month = -1

    for month in range(1, months + 1):
        if month == 1:
            revenue = start_revenue
        else:
            # Compound the growth on the previous month's revenue
            revenue = data[month-2]['Revenue'] * (1 + growth_rate)

        units = revenue / price_per_unit
        variable_costs = units * variable_cost_per_unit
        total_costs = fixed_costs + variable_costs
        net_cash_flow = revenue - total_costs
        cumulative_cash_flow += net_cash_flow

        # Track the maximum cumulative loss (peak cash requirement)
        if cumulative_cash_flow < max_cash_needed:
            max_cash_needed = cumulative_cash_flow

        data.append({
            "Month": month,
            "Revenue": revenue,
            "Units": units,
            "Total Costs": total_costs,
            "Net Cash Flow": net_cash_flow,
            "Cumulative Cash Flow": cumulative_cash_flow
        })

        if net_cash_flow > 0 and break_even_month == -1:
            break_even_month = month

    df = pd.DataFrame(data)
    # Use absolute value for a more intuitive "cash required" number
    cash_required = abs(max_cash_needed) if break_even_month != -1 else abs(cumulative_cash_flow)

    return df, break_even_month, cash_required

# --- Inputs ---
start_revenue = 5000
fixed_costs = 8000
price_per_unit = 50
variable_cost_per_unit = 20
months_to_project = 24 # Projecting for 24 months to ensure we see the trend

# --- Calculations ---
# 1. Break-Even Revenue Point
# Break-even is where Revenue = Fixed Costs + Variable Costs
# Let R be revenue. Units = R / 50. Variable Costs = (R / 50) * 20 = 0.4R
# R = 8000 + 0.4R => 0.6R = 8000 => R = 8000 / 0.6
break_even_revenue = fixed_costs / (1 - (variable_cost_per_unit / price_per_unit))
print(f"Monthly Break-Even Revenue Point: ${break_even_revenue:,.2f}\n")


# 2. Base Case: 15% Growth
base_growth = 0.15
df_base, be_month_base, cash_base = run_projection(
    start_revenue, fixed_costs, price_per_unit, variable_cost_per_unit, base_growth, months_to_project, "Base Case"
)
print("--- Base Case (15% MoM Growth) ---")
print(df_base.round(2).to_string(index=False))
print(f"\nTime to Break-Even: Month {be_month_base}")
print(f"Cash Required to Reach Break-Even: ${cash_base:,.2f}\n")


# 3. Conservative Case: 10% Growth
conservative_growth = 0.10
df_cons, be_month_cons, cash_cons = run_projection(
    start_revenue, fixed_costs, price_per_unit, variable_cost_per_unit, conservative_growth, months_to_project, "Conservative Case"
)
print("--- Conservative Case (10% MoM Growth) ---")
print(f"Time to Break-Even: Month {be_month_cons}")
print(f"Cash Required to Reach Break-Even: ${cash_cons:,.2f}\n")


# 4. Worst Case: 5% Growth
worst_growth = 0.05
df_worst, be_month_worst, cash_worst = run_projection(
    start_revenue, fixed_costs, price_per_unit, variable_cost_per_unit, worst_growth, months_to_project, "Worst Case"
)
print("--- Worst Case (5% MoM Growth) ---")
if be_month_worst != -1:
    print(f"Time to Break-Even: Month {be_month_worst}")
    print(f"Cash Required to Reach Break-Even: ${cash_worst:,.2f}")
else:
    print(f"Does not break even within {months_to_project} months.")
    print(f"Cash Burned after {months_to_project} months: ${cash_worst:,.2f}")
